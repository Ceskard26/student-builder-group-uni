# ─────────────────────────────────────────────────────────────
# Auth.js (NextAuth v5)
# ─────────────────────────────────────────────────────────────
# Genera uno con: npx auth secret  (o `openssl rand -base64 32`)
AUTH_SECRET=
# URL pública del sitio (sin slash final). En local: http://localhost:3000
AUTH_URL=http://localhost:3000

# Credenciales OAuth de Google (ver README: sección "Google Cloud Console")
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Dominio institucional permitido para AWS Academy (sin @)
ALLOWED_EMAIL_DOMAIN=uni.pe

# ─────────────────────────────────────────────────────────────
# AWS / DynamoDB
# ─────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
# Credenciales solo necesarias en desarrollo local. En Amplify usa el rol de servicio.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_TABLE_NAME=sbg-uni-main

# ─────────────────────────────────────────────────────────────
# Ventana de inscripción (America/Lima)
# ─────────────────────────────────────────────────────────────
ENROLLMENT_OPEN_AT=2026-08-22T00:00:00-05:00
ENROLLMENT_CLOSE_AT=2026-09-13T23:59:59-05:00
# Identificador de la cohorte actual, usado en las claves de DynamoDB
COHORT_ID=2026-2

# ─────────────────────────────────────────────────────────────
# Correo (Gmail SMTP con App Password)
# ─────────────────────────────────────────────────────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM="AWS Student Builder Group UNI <no-reply@example.com>"
# Correo de contacto mostrado en las plantillas
MAIL_CONTACT=

# ─────────────────────────────────────────────────────────────
# Panel de administración
# ─────────────────────────────────────────────────────────────
# Lista de correos separados por comas con acceso al panel /admin
ADMIN_EMAILS=admin1@uni.pe,admin2@uni.pe
